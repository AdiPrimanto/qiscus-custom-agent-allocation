# Same Postgres as the Express service — Internal Database URL on Render.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qiscus_agent_allocation

# HTTP Basic Auth password (any username works). Required — the server
# refuses requests without it. See server/middleware/auth.ts.
NUXT_DASHBOARD_PASSWORD=

# The "Coba lagi" retry button (server/api/assignments/[id]/retry.post.ts)
# imports src/allocation/reconcile.ts directly, whose dependency chain loads
# src/config/env.ts — which eagerly requires these at import time, same as
# the Express service. QISCUS_APP_ID and QISCUS_SECRET_KEY must be the same
# real values as the Express service's (the retry button calls Qiscus's
# assign_agent API for real). WEBHOOK_SECRET is only required by env.ts's
# validation — the dashboard never actually uses it — any non-empty value
# works.
QISCUS_APP_ID=
QISCUS_SECRET_KEY=
WEBHOOK_SECRET=unused-by-dashboard
