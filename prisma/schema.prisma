generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agent {
  id            Int          @id @default(autoincrement())
  qiscusAgentId Int          @unique @map("qiscus_agent_id")
  name          String
  email         String
  maxConcurrent Int          @default(2) @map("max_concurrent")
  offlineSince  DateTime?    @map("offline_since")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  assignments   Assignment[]

  @@map("agents")
}

enum AssignmentStatus {
  waiting
  assigned
  resolved
}

model Assignment {
  id                 Int              @id @default(autoincrement())
  roomId             String           @map("room_id")
  agentId            Int?             @map("agent_id")
  agent              Agent?           @relation(fields: [agentId], references: [id])
  status             AssignmentStatus @default(waiting)
  // Written once from the webhook's `name` field at creation, never updated
  // afterward — lets the dashboard search/filter by customer. Re-introduced
  // deliberately after being dropped as unused PII (see migration
  // 20260820053603, which dropped a customer *email* column); now has a
  // real consumer, so the trade-off was revisited.
  customerName       String?          @map("customer_name")
  createdAt          DateTime         @default(now()) @map("created_at")
  assignedAt         DateTime?        @map("assigned_at")
  resolvedAt         DateTime?        @map("resolved_at")
  // Set only when Qiscus's assign_agent call actually errors — never when
  // pickAgent simply finds no eligible agent (that's not an error, just
  // normal backlog). reconcile uses lastAssignErrorStatus to decide whether
  // to keep retrying: a 4xx is Qiscus explicitly rejecting this room, so
  // further identical retries are pointless; a room with no recorded error
  // at all is always retried, no matter how long it's been waiting.
  lastAssignErrorAt     DateTime?     @map("last_assign_error_at")
  lastAssignErrorStatus Int?          @map("last_assign_error_status")

  @@index([status, createdAt])
  @@index([roomId])
  @@map("assignments")
}
